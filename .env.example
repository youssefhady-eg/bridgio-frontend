# BRIDGIO frontend — example environment values only. Never put real secrets here.
# Copy to `.env` for local use. `.env` is git-ignored.

# Which adapter the single API layer uses: `mock` (default for this MVP) or `http`.
VITE_API_ADAPTER=mock

# Mentingo API base URL. PROPOSED / unconfirmed — used only when VITE_API_ADAPTER=http.
# No live Mentingo backend is connected in Stage 0; this is a placeholder example.
VITE_API_URL=http://localhost:3001/api/v1

# Mock data scenario: `seeded` (demo data) or `empty` (for empty-state work).
VITE_MOCK_SCENARIO=seeded

# Mock starting session: `teacher`, `student`, `assistant`, `parent`, or `none`.
# Mock convenience only. Real sign-in is Mentingo-owned and is NOT built in Stage 0.
# Use `none` for deployed previews (for example Vercel): the build then starts
# signed out, so the sign-in form and the account menu can be tested. With any
# other value the session is baked into the build and sign-out lasts until reload.
VITE_MOCK_SESSION=teacher

# HTTP request timeout in milliseconds (http adapter only).
VITE_API_TIMEOUT_MS=15000

# Developer chrome (stage banner, working-names note, English build note and the
# preview-role switcher). Visible by default; set to `false` for a user-facing build.
# VITE_SHOW_DEV_CHROME=false
